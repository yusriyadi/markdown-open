{
  "name": "markdown-open",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build --target aarch64-apple-darwin && node scripts/package-macos.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "android:init": "tauri android init --skip-targets-install",
    "android:dev": "tauri android dev",
    "android:apk": "tauri android build --debug --target aarch64 --apk",
    "android:apk:release": "tauri android build --target aarch64 --apk"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.0",
    "mermaid": "^12.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^27.0.1",
    "typescript": "~5.7.3",
    "vite": "^6.4.1",
    "vitest": "^3.2.7"
  },
  "description": "Offline Markdown and Mermaid viewer for macOS and the web"
}
