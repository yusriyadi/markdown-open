{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Markdown Open",
  "version": "1.1.1",
  "identifier": "com.markdown-open.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Markdown Open",
      "width": 1100,
      "height": 750,
      "minWidth": 600,
      "minHeight": 400,
      "zoomHotkeysEnabled": true
    }],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: http:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "Offline Markdown and Mermaid viewer",
    "icon": ["../assets/icon.icns"],
    "fileAssociations": [{"ext": ["md", "markdown"], "name": "Markdown", "role": "Viewer"}],
    "macOS": {"minimumSystemVersion": "11.0"}
  }
}
